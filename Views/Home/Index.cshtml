@{
    ViewData["Title"] = "Home Page";

    decimal currentYearExpenses = ViewBag.CurrentYearExpenses;
    decimal previousYearExpenses = ViewBag.PreviousYearExpenses;
    decimal expensesDiff = ViewBag.ExpensesDifference;
    decimal expensesPercent = ViewBag.ExpensesPercentage;
}

<style>
    .budget-section {
        background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
        border-radius: 2rem;
        padding: 2.5rem;
        margin: 2rem 0;
        color: white;
        box-shadow: 0 20px 60px rgba(102, 126, 234, 0.3);
    }

    .year-card {
        background: rgba(255, 255, 255, 0.95);
        border-radius: 1.5rem;
        padding: 2rem;
        margin-bottom: 1.5rem;
        box-shadow: 0 10px 30px rgba(0, 0, 0, 0.1);
        transition: transform 0.3s ease;
    }

        .year-card:hover {
            transform: translateY(-5px);
        }

    .year-title {
        font-size: 1.8rem;
        font-weight: 800;
        background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
        -webkit-background-clip: text;
        -webkit-text-fill-color: transparent;
        background-clip: text;
        margin-bottom: 1.5rem;
        text-align: center;
    }

    .category-grid {
        display: grid;
        grid-template-columns: repeat(auto-fit, minmax(200px, 1fr));
        gap: 1rem;
        margin-top: 1rem;
    }

    .category-item {
        background: linear-gradient(135deg, rgba(102, 126, 234, 0.1) 0%, rgba(118, 75, 162, 0.1) 100%);
        border-radius: 1rem;
        padding: 1.5rem;
        text-align: center;
        border: 2px solid rgba(102, 126, 234, 0.2);
    }

    .category-icon {
        font-size: 2.5rem;
        margin-bottom: 0.5rem;
    }

    .category-label {
        font-size: 0.9rem;
        color: #718096;
        margin-bottom: 0.5rem;
    }

    .category-value {
        font-size: 1.5rem;
        font-weight: 700;
        color: #2d3748;
    }

    .total-badge {
        background: linear-gradient(135deg, #11998e 0%, #38ef7d 100%);
        color: white;
        padding: 1rem 2rem;
        border-radius: 1rem;
        font-size: 1.8rem;
        font-weight: 800;
        display: inline-block;
        margin-top: 1rem;
        box-shadow: 0 10px 30px rgba(17, 153, 142, 0.3);
    }

    .comparison-badge {
        display: inline-flex;
        align-items: center;
        gap: 0.5rem;
        padding: 0.5rem 1rem;
        border-radius: 0.75rem;
        font-weight: 700;
        font-size: 0.9rem;
        margin-top: 0.5rem;
    }

        .comparison-badge.positive {
            background: rgba(17, 153, 142, 0.1);
            color: #11998e;
        }

        .comparison-badge.negative {
            background: rgba(220, 53, 69, 0.1);
            color: #dc3545;
        }

        .comparison-badge.neutral {
            background: rgba(108, 117, 125, 0.1);
            color: #6c757d;
        }

    .section-title {
        font-size: 2rem;
        font-weight: 800;
        text-align: center;
        margin-bottom: 2rem;
    }


    .chart-card {
        background: linear-gradient(180deg, #ffffff 0%, #f8f9fa 100%);
        border: 1px solid #e0e0e0;
        transition: all 0.3s ease;
    }

        .chart-card:hover {
            transform: translateY(-4px);
            box-shadow: 0 8px 20px rgba(0, 0, 0, 0.1);
        }

    .chart-header h3 {
        font-size: 1.4rem;
        color: #333;
        letter-spacing: 0.5px;
    }

    #revenuesExpensesLineChart {
        background: #fff;
        border-radius: 1rem;
    }
</style>



<div class="container" dir="rtl">


    <!-- Budget Year-over-Year Comparison Section -->
    @if (ViewBag.HasBudgetData)
    {
        <div class="budget-section">
            <h2 class="section-title" style="color: white;">
                <i class="bi bi-bar-chart-fill"></i>
                مقارنة الايرادات السنوية
            </h2>

            <div class="row">
                <!-- Previous Year -->
                <div class="col-md-6">
                    <div class="year-card">
                        <div class="year-title">
                            <i class="bi bi-calendar-check"></i>
                            السنة السابقة @ViewBag.PreviousYear/@(ViewBag.PreviousYear + 1)
                        </div>

                        <div class="category-grid">
                            <div class="category-item">
                                <div class="category-icon">🥚</div>
                                <div class="category-label">البيض</div>
                                <div class="category-value">@ViewBag.PreviousYearEgg.ToString("N2")</div>
                            </div>
                            <div class="category-item">
                                <div class="category-icon">♻️</div>
                                <div class="category-label">المخلفات</div>
                                <div class="category-value">@ViewBag.PreviousYearWaste.ToString("N2")</div>
                            </div>
                            <div class="category-item">
                                <div class="category-icon">🐔</div>
                                <div class="category-label">القطيع</div>
                                <div class="category-value">@ViewBag.PreviousYearHerd.ToString("N2")</div>
                            </div>
                            <div class="category-item">
                                <div class="category-icon">📦</div>
                                <div class="category-label">متنوعات</div>
                                <div class="category-value">@ViewBag.PreviousYearMiscellaneous.ToString("N2")</div>
                            </div>
                        </div>

                        <div class="text-center">
                            <div class="total-badge">
                                الإجمالي: @ViewBag.PreviousYearTotal.ToString("N2")
                            </div>
                        </div>
                    </div>
                </div>

                <!-- Current Year -->
                <div class="col-md-6">
                    <div class="year-card">
                        <div class="year-title">
                            <i class="bi bi-calendar-event"></i>
                            السنة الحالية @ViewBag.CurrentYear/@(ViewBag.CurrentYear + 1)
                        </div>

                        <div class="category-grid">
                            <div class="category-item">
                                <div class="category-icon">🥚</div>
                                <div class="category-label">البيض</div>
                                <div class="category-value">@ViewBag.CurrentYearEgg.ToString("N2")</div>
                                @if (ViewBag.EggDifference != 0)
                                {
                                    <div class="comparison-badge @(ViewBag.EggDifference > 0 ? "positive" : "negative")">
                                        <i class="bi bi-arrow-@(ViewBag.EggDifference > 0 ? "up" : "down")-circle-fill"></i>
                                        @(ViewBag.EggDifference > 0 ? "+" : "")@ViewBag.EggDifference.ToString("N2")
                                        (@(ViewBag.EggPercentage > 0 ? "+" : "")@ViewBag.EggPercentage.ToString("N1")%)
                                    </div>
                                }
                            </div>
                            <div class="category-item">
                                <div class="category-icon">♻️</div>
                                <div class="category-label">المخلفات</div>
                                <div class="category-value">@ViewBag.CurrentYearWaste.ToString("N2")</div>
                                @if (ViewBag.WasteDifference != 0)
                                {
                                    <div class="comparison-badge @(ViewBag.WasteDifference > 0 ? "positive" : "negative")">
                                        <i class="bi bi-arrow-@(ViewBag.WasteDifference > 0 ? "up" : "down")-circle-fill"></i>
                                        @(ViewBag.WasteDifference > 0 ? "+" : "")@ViewBag.WasteDifference.ToString("N2")
                                        (@(ViewBag.WastePercentage > 0 ? "+" : "")@ViewBag.WastePercentage.ToString("N1")%)
                                    </div>
                                }
                            </div>
                            <div class="category-item">
                                <div class="category-icon">🐔</div>
                                <div class="category-label">القطيع</div>
                                <div class="category-value">@ViewBag.CurrentYearHerd.ToString("N2")</div>
                                @if (ViewBag.HerdDifference != 0)
                                {
                                    <div class="comparison-badge @(ViewBag.HerdDifference > 0 ? "positive" : "negative")">
                                        <i class="bi bi-arrow-@(ViewBag.HerdDifference > 0 ? "up" : "down")-circle-fill"></i>
                                        @(ViewBag.HerdDifference > 0 ? "+" : "")@ViewBag.HerdDifference.ToString("N2")
                                        (@(ViewBag.HerdPercentage > 0 ? "+" : "")@ViewBag.HerdPercentage.ToString("N1")%)
                                    </div>
                                }
                            </div>
                            <div class="category-item">
                                <div class="category-icon">📦</div>
                                <div class="category-label">متنوعات</div>
                                <div class="category-value">@ViewBag.CurrentYearMiscellaneous.ToString("N2")</div>
                                @if (ViewBag.MiscellaneousDifference != 0)
                                {
                                    <div class="comparison-badge @(ViewBag.MiscellaneousDifference > 0 ? "positive" : "negative")">
                                        <i class="bi bi-arrow-@(ViewBag.MiscellaneousDifference > 0 ? "up" : "down")-circle-fill"></i>
                                        @(ViewBag.MiscellaneousDifference > 0 ? "+" : "")@ViewBag.MiscellaneousDifference.ToString("N2")
                                        (@(ViewBag.MiscellaneousPercentage > 0 ? "+" : "")@ViewBag.MiscellaneousPercentage.ToString("N1")%)
                                    </div>
                                }
                            </div>
                        </div>

                        <div class="text-center">
                            <div class="total-badge">
                                الإجمالي: @ViewBag.CurrentYearTotal.ToString("N2")
                            </div>
                            @if (ViewBag.TotalDifference != 0)
                            {
                                <div class="comparison-badge @(ViewBag.TotalDifference > 0 ? "positive" : "negative")" style="font-size: 1.1rem;">
                                    <i class="bi bi-arrow-@(ViewBag.TotalDifference > 0 ? "up" : "down")-circle-fill"></i>
                                    @(ViewBag.TotalDifference > 0 ? "+" : "")@ViewBag.TotalDifference.ToString("N2")
                                    (@(ViewBag.TotalPercentage > 0 ? "+" : "")@ViewBag.TotalPercentage.ToString("N1")%)
                                </div>
                            }
                        </div>
                    </div>
                </div>
            </div>

            <!-- Budget Comparison Charts -->
            <div class="row mt-4">
                <div class="col-md-6">
                    <div id="budgetComparisonChart" style="height: 400px; background: white; border-radius: 1rem; padding: 1rem;"></div>
                </div>
                <div class="col-md-6">
                    <div id="budgetPieChart" style="height: 400px; background: white; border-radius: 1rem; padding: 1rem;"></div>
                </div>
            </div>
        </div>
    }


    <!-- ======== EXPENSES SECTION ======== -->
    @if (ViewBag.CurrentYearExpenses != null)
    {
        <div class="budget-section mt-5">
            <h2 class="section-title" style="color: white;">
                <i class="bi bi-cash-stack"></i>
                مقارنة المصروفات السنوية
            </h2>

            <div class="row">
                <div class="col-md-6">
                    <div class="year-card">
                        <div class="year-title">
                            السنة السابقة @ViewBag.PreviousYear/@(ViewBag.PreviousYear + 1)
                        </div>
                        <div class="text-center">
                            <div class="total-badge" style="background: linear-gradient(135deg,#f6d365 0%,#fda085 100%);">
                                المصروفات: @ViewBag.PreviousYearExpenses.ToString("N2")
                            </div>
                        </div>
                    </div>
                </div>

                <div class="col-md-6">
                    <div class="year-card">
                        <div class="year-title">
                            السنة الحالية @ViewBag.CurrentYear/@(ViewBag.CurrentYear + 1)
                        </div>
                        <div class="text-center">
                            <div class="total-badge" style="background: linear-gradient(135deg,#f6d365 0%,#fda085 100%);">
                                المصروفات: @ViewBag.CurrentYearExpenses.ToString("N2")
                            </div>
                            @if (ViewBag.ExpensesDifference != 0)
                            {
                                <div class="comparison-badge @(ViewBag.ExpensesDifference > 0 ? "negative" : "positive")" style="font-size:1.1rem;">
                                    <i class="bi bi-arrow-@(ViewBag.ExpensesDifference > 0 ? "up" : "down")-circle-fill"></i>
                                    @(ViewBag.ExpensesDifference > 0 ? "+" : "")@ViewBag.ExpensesDifference.ToString("N2")
                                    (@(ViewBag.ExpensesPercentage > 0 ? "+" : "")@ViewBag.ExpensesPercentage%)
                                </div>
                            }
                        </div>
                    </div>
                </div>
            </div>

            <!-- ======== CHARTS SECTION ======== -->
            <div class="row mt-4">
                <!-- Bar Chart -->
                <div class="col-md-6">
                    <div id="revenuesExpensesChart"
                         style="height: 400px; background: white; border-radius: 1rem; padding: 1rem;">
                    </div>
                </div>

                <!-- Pie Chart -->
                <div class="col-md-6">
                    <div id="expensesPieChart"
                         style="height: 400px; background: white; border-radius: 1rem; padding: 1rem;">
                    </div>
                </div>
                <div class="row mt-5 justify-content-center">
                    <div class="col-lg-10">
                        <div class="chart-card shadow-lg p-4 rounded-4 position-relative overflow-hidden">
                            <div class="chart-header mb-3 d-flex align-items-center justify-content-between">
                                <h3 class="fw-bold text-dark m-0">
                                    <i class="bi bi-graph-up-arrow text-success me-2"></i>
                                    اتجاه الإيرادات والمصروفات السنوية
                                </h3>
                                <span class="badge bg-gradient fs-6" style="background: linear-gradient(135deg,#38ef7d,#11998e);">
                                    تحليل الاتجاه المالي
                                </span>
                            </div>
                            <div id="revenuesExpensesLineChart" style="height: 420px;"></div>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        
    }


</div>

<!-- Line Chart Container -->
<div style="display: flex; justify-content: space-between; align-items: flex-start; gap: 20px; margin-top: 50px;">
    <div id="containerPieChartAmount" style="flex: 1; height: 400px;"></div>
    <div id="containerPieChartRestAmount" style="flex: 1; height: 400px;"></div>
    <div id="containerPieChartTotalAmount" style="flex: 1; height: 400px;"></div>
</div>

<div id="containerLineChart" style="width:100%; height:400px;"></div>
<div id="containerColumnChart" style="width:100%; height:400px; margin-top: 50px;"></div>

@section Scripts {
    <script src="https://code.highcharts.com/highcharts.js"></script>
    <script src="https://code.highcharts.com/modules/exporting.js"></script>
    <script>
        // Get data from ViewBag
        const data = @Html.Raw(Newtonsoft.Json.JsonConvert.SerializeObject(ViewBag.ChartData));

        // Extract the data for each series (production metrics)
        const centers = data.map(item => item.centerName);
        const series1Data = data.map(item => item.Amount);
        const series2Data = data.map(item => item.RestAmount);

        const totalAmount = data.length > 0 ? data[0].TotalAmount : 0;
        const totalRestAmount = data.length > 0 ? data[0].TotalRestAmount : 0;

        // Budget comparison data
        const hasBudgetData = @Html.Raw(ViewBag.HasBudgetData ? "true" : "false");

        if (hasBudgetData) {
            const previousYear = @ViewBag.PreviousYear;
            const currentYear = @ViewBag.CurrentYear;

            const previousYearData = {
                egg: @ViewBag.PreviousYearEgg,
                waste: @ViewBag.PreviousYearWaste,
                herd: @ViewBag.PreviousYearHerd,
                misc: @ViewBag.PreviousYearMiscellaneous,
                total: @ViewBag.PreviousYearTotal
            };

            const currentYearData = {
                egg: @ViewBag.CurrentYearEgg,
                waste: @ViewBag.CurrentYearWaste,
                herd: @ViewBag.CurrentYearHerd,
                misc: @ViewBag.CurrentYearMiscellaneous,
                total: @ViewBag.CurrentYearTotal
            };

            // Budget Comparison Column Chart
            Highcharts.chart('budgetComparisonChart', {
                chart: {
                    type: 'column'
                },
                title: {
                    text: 'مقارنة الايرادات حسب الفئة',
                    style: { fontSize: '18px', fontWeight: 'bold' }
                },
                xAxis: {
                    categories: ['البيض', 'المخلفات', 'القطيع', 'متنوعات'],
                    title: { text: 'الفئة' }
                },
                yAxis: {
                    title: { text: 'القيمة (جنيه)' },
                    labels: { format: '{value:,.0f}' }
                },
                tooltip: {
                    shared: true,
                    pointFormat: '<span style="color:{series.color}">{series.name}</span>: <b>{point.y:,.2f} جنيه</b><br/>'
                },
                plotOptions: {
                    column: {
                        borderRadius: 5
                    }
                },
                series: [
                    {
                        name: `السنة السابقة (${previousYear})`,
                        data: [previousYearData.egg, previousYearData.waste, previousYearData.herd, previousYearData.misc],
                        color: '#667eea'
                    },
                    {
                        name: `السنة الحالية (${currentYear})`,
                        data: [currentYearData.egg, currentYearData.waste, currentYearData.herd, currentYearData.misc],
                        color: '#11998e'
                    }
                ]
            });

            // Budget Pie Chart for Current Year
            Highcharts.chart('budgetPieChart', {
                chart: {
                    type: 'pie'
                },
                title: {
                    text: `توزيع الايرادات للسنة الحالية ${currentYear}/${currentYear + 1}`,
                    style: { fontSize: '18px', fontWeight: 'bold' }
                },
                tooltip: {
                    pointFormat: '<b>{point.percentage:.1f}%</b> ({point.y:,.2f} جنيه)'
                },
                plotOptions: {
                    pie: {
                        allowPointSelect: true,
                        cursor: 'pointer',
                        dataLabels: {
                            enabled: true,
                            format: '<b>{point.name}</b>: {point.percentage:.1f}%'
                        }
                    }
                },
                series: [{
                    name: 'القيمة',
                    colorByPoint: true,
                    data: [
                        { name: 'البيض 🥚', y: currentYearData.egg, color: '#667eea' },
                        { name: 'المخلفات ♻️', y: currentYearData.waste, color: '#11998e' },
                        { name: 'القطيع 🐔', y: currentYearData.herd, color: '#fa709a' },
                        { name: 'متنوعات 📦', y: currentYearData.misc, color: '#4facfe' }
                    ]
                }]
            });
        }

        // Existing charts (Centers data)
        Highcharts.chart('containerPieChartTotalAmount', {
            chart: { type: 'pie' },
            title: { text: 'إجمالي المسدد والمديونية' },
            tooltip: { pointFormat: '<b>{point.percentage:.1f}%</b> ({point.y} جنيها)' },
            series: [{
                name: 'الإجمالي',
                data: [
                    { name: 'إجمالي المسدد', y: totalAmount, color: '#4CAF50' },
                    { name: 'إجمالي المديونية', y: totalRestAmount, color: '#FF5733' }
                ]
            }]
        });

        Highcharts.chart('containerLineChart', {
            chart: { type: 'line' },
            title: { text: 'مخطط لاجمالي المسدد والمديونية من كل مركز', align: 'center' },
            xAxis: { categories: centers, title: { text: 'المراكز' } },
            yAxis: { title: { text: 'القيمة (جنيها)' }, labels: { format: '{value} جنيها' } },
            tooltip: { shared: true, pointFormat: '<span style="color:{series.color}">{series.name}</span>: <b>{point.y} جنيها</b><br/>' },
            series: [
                { name: 'المسدد', data: series1Data, tooltip: { valueSuffix: ' جنيها' } },
                { name: 'المديونية', data: series2Data, tooltip: { valueSuffix: ' جنيها' } }
            ]
        });

        Highcharts.chart('containerColumnChart', {
            chart: { type: 'column' },
            title: { text: 'رسم بياني لاجمالي المسدد والمديونية من كل مركز', align: 'center' },
            xAxis: { categories: centers, title: { text: 'المراكز' } },
            yAxis: { title: { text: 'القيمة (جنيها)' }, labels: { format: '{value} جنيها' } },
            tooltip: { shared: true, pointFormat: '<span style="color:{series.color}">{series.name}</span>: <b>{point.y} جنيها</b><br/>' },
            series: [
                { name: 'المسدد', data: series1Data, tooltip: { valueSuffix: ' جنيها' } },
                { name: 'المديونية', data: series2Data, tooltip: { valueSuffix: ' جنيها' } }
            ],
            exporting: {
                enabled: true,
                buttons: {
                    contextButton: {
                        menuItems: ['downloadPNG', 'downloadJPEG', 'downloadPDF', 'downloadSVG']
                    }
                }
            }
        });

        Highcharts.chart('containerPieChartAmount', {
            chart: { type: 'pie' },
            title: { text: 'نسب المسدد من المراكز' },
            tooltip: { pointFormat: '<b>{point.percentage:.1f}%</b> ({point.y} جنيها)' },
            series: [{
                name: 'المسدد',
                data: centers.map((center, i) => ({ name: center, y: series1Data[i] }))
            }]
        });

        Highcharts.chart('containerPieChartRestAmount', {
            chart: { type: 'pie' },
            title: { text: 'نسب المديونية من المراكز' },
            tooltip: { pointFormat: '<b>{point.percentage:.1f}%</b> ({point.y} جنيها)' },
            series: [{
                name: 'المديونية',
                data: centers.map((center, i) => ({ name: center, y: series2Data[i] }))
            }]
        });


          const revExpData = @Html.Raw(Newtonsoft.Json.JsonConvert.SerializeObject(ViewBag.RevenueExpensesChart));

        Highcharts.chart('revenuesExpensesChart', {
            chart: { type: 'column' },
            title: { text: 'مقارنة الإيرادات والمصروفات السنوية' },
            xAxis: {
                categories: revExpData.map(d => d.Year),
                title: { text: 'السنة المالية' }
            },
            yAxis: {
                title: { text: 'القيمة بالجنيه' },
                labels: { formatter() { return this.value.toLocaleString(); } }
            },
            tooltip: {
                shared: true,
                valueSuffix: ' جنيه'
            },
            plotOptions: {
                column: { borderRadius: 5, pointPadding: 0.1, groupPadding: 0.15 }
            },
            series: [
                {
                    name: 'الإيرادات',
                    data: revExpData.map(d => d.Revenues),
                    color: '#38ef7d'
                },
                {
                    name: 'المصروفات',
                    data: revExpData.map(d => d.Expenses),
                    color: '#f6ad55'
                }
            ]
        });



               Highcharts.chart('revenuesExpensesChart', {
            chart: { type: 'column' },
            title: { text: 'مقارنة الإيرادات والمصروفات' },
            xAxis: {
                categories: [
                    '@ViewBag.PreviousYear/@(ViewBag.PreviousYear + 1)',
                    '@ViewBag.CurrentYear/@(ViewBag.CurrentYear + 1)'
                ]
            },
            yAxis: { title: { text: 'القيمة بالجنيه' } },
            series: [{
                name: 'الإيرادات',
                data: [@ViewBag.PreviousYearTotal, @ViewBag.CurrentYearTotal],
                color: '#28a745'
            }, {
                name: 'المصروفات',
                data: [@ViewBag.PreviousYearExpenses, @ViewBag.CurrentYearExpenses],
                color: '#dc3545'
            }]
        });

        // Pie Chart: Expenses Comparison (Current vs Previous Year)
        Highcharts.chart('expensesPieChart', {
            chart: { type: 'pie' },
            title: { text: 'نسبة المصروفات بين السنتين' },
            tooltip: { pointFormat: '<b>{point.y:.2f} جنيه</b> ({point.percentage:.1f}%)' },
            plotOptions: {
                pie: {
                    allowPointSelect: true,
                    cursor: 'pointer',
                    dataLabels: {
                        enabled: true,
                        format: '<b>{point.name}</b>: {point.percentage:.1f} %'
                    }
                }
            },
            series: [{
                name: 'المصروفات',
                colorByPoint: true,
                data: [
                    { name: 'السنة السابقة', y: @ViewBag.PreviousYearExpenses },
                    { name: 'السنة الحالية', y: @ViewBag.CurrentYearExpenses }
                ]
            }]
        });



