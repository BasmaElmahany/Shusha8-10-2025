@model IEnumerable<Shusha_project_BackUp.Data.Expenses>
@using Shusha_project_BackUp.Data


@{
    ViewData["Title"] = "سجل المصروفات";
    Layout = "~/Views/Shared/_Layout.cshtml";
    var totals = ViewBag.Totals as IEnumerable<Shusha_project_BackUp.Data.Expenses_total>;
}

<style>
    /* ✅ reuse full style from Waste_Sales Index */
    :root {
        --primary-color: #0d6efd;
        --success-color: #198754;
        --info-color: #0dcaf0;
        --warning-color: #ffc107;
        --danger-color: #dc3545;
        --expense-color: #764ba2 100%;
        --expense-light: #c8b6ff;
    }

    .page-header {
        background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
        color: white;
        padding: 2.5rem 0;
        margin-bottom: 2rem;
        border-radius: 1rem;
        box-shadow: 0 6px 12px rgba(0, 0, 0, 0.15);
    }

        .page-header h1 {
            margin: 0;
            font-weight: 700;
            font-size: 2.5rem;
        }

        .page-header p {
            margin: 0.5rem 0 0 0;
            font-size: 1.1rem;
            opacity: 0.9;
        }

    .table-container {
        background: white;
        border-radius: 1rem;
        padding: 1.5rem;
        box-shadow: 0 2px 8px rgba(0,0,0,0.08);
        overflow-x: auto;
    }

    #expensesTable thead th {
        background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
        color: white;
        text-align: center;
        position: sticky;
        top: 0;
        z-index: 10;
    }

    #expensesTable tbody td {
        text-align: center;
        vertical-align: middle;
    }

    .action-buttons {
        display: flex;
        gap: 0.5rem;
        justify-content: center;
    }

    .total-badge {
        background: linear-gradient(135deg, var(--success-color) 0%, #146c43 100%);
        color: white;
        padding: 0.5rem 1rem;
        border-radius: 0.5rem;
        font-weight: 700;
        display: inline-block;
    }


    .btn-action {
        background: linear-gradient(135deg, var(--expense-color), var(--primary-color));
        color: #fff;
        font-weight: 600;
        border: none;
        border-radius: 0.75rem;
        padding: 0.75rem 1.75rem;
        box-shadow: 0 4px 10px rgba(118, 75, 162, 0.3);
        transition: all 0.3s ease;
        display: inline-flex;
        align-items: center;
        gap: 0.5rem;
        position: relative;
        overflow: hidden;
        z-index: 1;
    }

        .btn-action i {
            font-size: 1.2rem;
        }

        /* تأثير الإضاءة عند المرور */
        .btn-action::before {
            content: "";
            position: absolute;
            top: 0;
            left: -100%;
            width: 100%;
            height: 100%;
            background: linear-gradient( 120deg, rgba(255, 255, 255, 0.3), rgba(255, 255, 255, 0) );
            transition: all 0.6s ease;
            z-index: 0;
        }

        .btn-action:hover::before {
            left: 100%;
        }

        .btn-action:hover {
            transform: translateY(-3px);
            box-shadow: 0 6px 16px rgba(118, 75, 162, 0.4);
        }

        .btn-action:active {
            transform: scale(0.97);
        }

    /* لصف العنصر */
    .action-header {
        background: linear-gradient(135deg, var(--expense-light), #f8f9fa);
        padding: 1rem 1.5rem;
        border-radius: 1rem;
        box-shadow: 0 2px 8px rgba(0, 0, 0, 0.05);
        margin-bottom: 2rem;
    }
</style>

<div class="page-header text-center">
    <h1><i class="bi bi-cash-stack"></i> سجل المصروفات</h1>
    <p>إدارة وتتبع جميع المصروفات حسب السنة المالية</p>
</div>

<!-- Action Buttons -->
<div class="d-flex justify-content-between align-items-center mb-3 action-header">
    <a asp-action="AddAll" class="btn btn-action">
        <i class="bi bi-plus-circle"></i>
        إضافة مصروفات جديدة
    </a>
</div>

<!-- Data Table -->
<div class="table-container mb-4">
    <table id="expensesTable" class="table table-striped table-hover">
        <thead>
            <tr>
                <th><i class="bi bi-calendar-event"></i> التاريخ</th>
                <th><i class="bi bi-tag"></i> نوع المصروف</th>
                <th><i class="bi bi-currency-dollar"></i> المبلغ</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var item in Model)
            {
                <tr>
                    <td>@item.date.ToString("yyyy-MM-dd")</td>
                    <td><strong>@item.type1.GetDisplayName()</strong></td>

                    <td><span class="badge bg-primary">@item.amount1.ToString("N2") جنيه</span></td>
                </tr>
            }
        </tbody>
    </table>
</div>

<!-- Totals Section -->
@if (totals != null && totals.Any())
{
    <div class="card shadow-sm mb-4">
        <div class="card-header text-center text-white" style="background: linear-gradient(135deg, var(--success-color) 0%, #198754 100%);">
            <i class="bi bi-bar-chart-line"></i> الإجماليات السنوية
        </div>
        <div class="card-body">
            <div class="table-responsive">
                <table class="table table-bordered table-hover align-middle text-center">
                    <thead class="table-success">
                        <tr>
                            <th>السنة المالية</th>
                            <th>إجمالي المصروفات</th>
                            @*   <th>إجراءات</th>*@
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var t in totals)
                        {
                            <tr>
                                <td>@t.year</td>
                                <td><span class="total-badge">@t.Total.ToString("N2") جنيه</span></td>
                             @*   <td>
                                    <div class="action-buttons">
                                        <a asp-action="EditTotal" asp-route-id="@t.Id" class="btn btn-warning btn-sm" title="تعديل" data-bs-toggle="tooltip">
                                            <i class="bi bi-pencil-square"></i>
                                        </a>
                                        <a asp-action="DeleteTotal" asp-route-id="@t.Id" class="btn btn-danger btn-sm" title="حذف" data-bs-toggle="tooltip">
                                            <i class="bi bi-trash"></i>
                                        </a>
                                    </div>
                                </td>*@
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
}

@section Scripts {
    <link rel="stylesheet" href="https://cdn.datatables.net/1.13.1/css/dataTables.bootstrap5.min.css">
    <script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>
    <script src="https://cdn.datatables.net/1.13.1/js/jquery.dataTables.min.js"></script>
    <script src="https://cdn.datatables.net/1.13.1/js/dataTables.bootstrap5.min.js"></script>
    <script>
        $(document).ready(function () {
            $('#expensesTable').DataTable({
                "language": {
                    "url": "https://cdn.datatables.net/plug-ins/1.13.1/i18n/ar.json"
                },
                "pagingType": "full_numbers",
                "responsive": true,
                "pageLength": 25,
                "order": [[0, "desc"]]
            });

            var tooltipTriggerList = [].slice.call(document.querySelectorAll('[data-bs-toggle="tooltip"]'));
            tooltipTriggerList.map(function (el) { return new bootstrap.Tooltip(el); });
        });
    </script>
}
