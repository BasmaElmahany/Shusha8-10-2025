@model Shusha_project_BackUp.Models.ExpensesFormViewModel
@{
    ViewData["Title"] = "إضافة المصروفات السنوية";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<!-- 🌈 نفس التنسيقات المخصصة -->
<style>
    body {
        background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
        min-height: 100vh;
        background-size: 400% 400%;
        animation: bgMove 15s ease infinite;
    }

    @@keyframes bgMove {
        0%

    {
        background-position: 0% 50%;
    }

    50% {
        background-position: 100% 50%;
    }

    100% {
        background-position: 0% 50%;
    }

    }

    .page-header {
        background: rgba(255, 255, 255, 0.1);
        color: #fff;
        padding: 2rem 0;
        margin-bottom: 2rem;
        border-radius: 1rem;
        text-align: center;
        box-shadow: 0 6px 12px rgba(0, 0, 0, 0.25);
        backdrop-filter: blur(8px);
        animation: fadeIn 1s ease;
    }

        .page-header h1 {
            font-weight: 700;
            font-size: 2rem;
            margin-bottom: 0.5rem;
        }

        .page-header p {
            font-size: 1rem;
            opacity: 0.9;
        }

    .icon-badge {
        background: rgba(255, 255, 255, 0.2);
        width: 80px;
        height: 80px;
        border-radius: 50%;
        display: flex;
        align-items: center;
        justify-content: center;
        margin: 0 auto 1rem;
        box-shadow: 0 0 10px rgba(255, 255, 255, 0.3);
    }

        .icon-badge i {
            font-size: 2rem;
            color: #fff;
        }

    .export-card {
        background: rgba(255, 255, 255, 0.9);
        border-radius: 1rem;
        box-shadow: 0 8px 20px rgba(0, 0, 0, 0.15);
        padding: 2rem;
        max-width: 1100px;
        margin: 0 auto 3rem;
        animation: slideUp 0.8s ease-out;
    }

    .info-card {
        background: rgba(106, 17, 203, 0.1);
        border: 1px solid rgba(106, 17, 203, 0.2);
        border-radius: 0.75rem;
        padding: 1.25rem;
        margin-bottom: 2rem;
    }

        .info-card h5 {
            color: #764ba2;
            font-weight: 700;
            margin-bottom: 1rem;
        }

        .info-card ul {
            list-style: none;
            padding-left: 0;
            color: #333;
        }

        .info-card li {
            margin-bottom: 0.5rem;
            font-size: 0.95rem;
        }

    .filter-section {
        margin-bottom: 2rem;
        border-left: 4px solid #764ba2;
        padding-left: 1rem;
    }

        .filter-section h4 {
            color: #764ba2;
            font-weight: 600;
            margin-bottom: 1rem;
        }

    .form-label {
        font-weight: 600;
        color: #333;
    }

    .form-control {
        border-radius: 0.6rem;
        border: 2px solid #e5e5e5;
        transition: all 0.3s ease;
        padding: 0.7rem 1rem;
    }

        .form-control:focus {
            border-color: #764ba2;
            box-shadow: 0 0 0 0.2rem rgba(106, 17, 203, 0.2);
        }

    .btn-export {
        background: linear-gradient(135deg, #764ba2, #9f7aea);
        border: none;
        color: white;
        padding: 0.75rem 2rem;
        font-weight: 600;
        border-radius: 0.6rem;
        transition: all 0.3s ease;
        display: flex;
        align-items: center;
        gap: 0.5rem;
        margin-top: 1rem;
    }

        .btn-export:hover {
            transform: translateY(-2px);
            box-shadow: 0 4px 12px rgba(106, 17, 203, 0.3);
        }

    @@keyframes fadeIn {
        from

    {
        opacity: 0;
        transform: translateY(-10px);
    }

    to {
        opacity: 1;
        transform: translateY(0);
    }

    }

    @@keyframes slideUp {
        from

    {
        opacity: 0;
        transform: translateY(20px);
    }

    to {
        opacity: 1;
        transform: translateY(0);
    }

    }

    /* خلفيات الأشكال الطائرة */
    .floating-shapes .shape {
        position: absolute;
        background: rgba(255, 255, 255, 0.15);
        border-radius: 50%;
        animation: float 10s infinite ease-in-out;
    }

        .floating-shapes .shape:nth-child(1) {
            width: 100px;
            height: 100px;
            top: 20%;
            left: 10%;
            animation-delay: 0s;
        }

        .floating-shapes .shape:nth-child(2) {
            width: 150px;
            height: 150px;
            bottom: 10%;
            right: 15%;
            animation-delay: 3s;
        }

        .floating-shapes .shape:nth-child(3) {
            width: 80px;
            height: 80px;
            top: 70%;
            left: 50%;
            animation-delay: 6s;
        }

    @@keyframes float {
        0%, 100%

    {
        transform: translateY(0) rotate(0deg);
    }

    50% {
        transform: translateY(-30px) rotate(15deg);
    }

    }
</style>

<div class="floating-shapes">
    <div class="shape"></div>
    <div class="shape"></div>
    <div class="shape"></div>
</div>

<!-- 🌟 رأس الصفحة -->
<div class="page-header text-center">
    <div class="icon-badge">
        <i class="bi bi-cash-stack"></i>
    </div>
    <h1>إضافة المصروفات السنوية</h1>
    <p>أدخل جميع أنواع المصروفات الخاصة بالسنة المالية الحالية</p>
</div>

<!-- 🧾 كارت الإدخال -->
<div class="export-card">
    <div class="info-card">
        <h5><i class="bi bi-info-circle-fill"></i> تفاصيل المصروفات</h5>
        <ul>
            <li><strong>المرتبات:</strong> إجمالي رواتب العاملين.</li>
            <li><strong>العلف:</strong> مصروفات تغذية القطيع.</li>
            <li><strong>القطيع:</strong> شراء أو صيانة القطيع.</li>
            <li><strong>الأدوية:</strong> مصروفات العلاج والتحصينات.</li>
            <li><strong>الكرتون والأطباق:</strong> مصروفات التعبئة والتغليف.</li>
            <li><strong>الوقود:</strong> مصروفات السولار.</li>
            <li><strong>الرخص والتحاليل:</strong> مصروفات الترخيص والتحاليل.</li>
            <li><strong>الصيانة والكهرباء والإعلانات:</strong> باقي أنواع المصروفات العامة.</li>
        </ul>
    </div>

    <!-- ✅ فورم إضافة المصروفات -->
    <form asp-action="AddAll" method="post">
        <div class="filter-section">
            <h4><i class="bi bi-calendar3"></i> بيانات السنة المالية</h4>
            <div class="row g-3">
                <div class="col-md-6">
                    <label class="form-label"><i class="bi bi-calendar-event"></i> تاريخ اليوم</label>
                    <input asp-for="Date" type="date" class="form-control" required />
                </div>
                <div class="col-md-6">
                    <label class="form-label"><i class="bi bi-calendar-range"></i> السنة المالية الحالية</label>
                    <input type="text" value="1/7/2025 - 30/6/2026" class="form-control" readonly />
                </div>
            </div>
        </div>

        <div class="filter-section">
            <h4><i class="bi bi-wallet2"></i> إدخال تفاصيل المصروفات</h4>
            <div class="row g-3">
                <div class="col-md-4">
                    <label class="form-label"><i class="bi bi-person-badge"></i> المرتبات</label>
                    <input asp-for="Salaries" class="form-control" type="number" step="0.01" />
                </div>
                <div class="col-md-4">
                    <label class="form-label"><i class="bi bi-basket-fill"></i> العلف</label>
                    <input asp-for="Feed" class="form-control" type="number" step="0.01" />
                </div>
                <div class="col-md-4">
                    <label class="form-label"><i class="bi bi-egg-fill"></i> القطيع</label>
                    <input asp-for="Herd" class="form-control" type="number" step="0.01" />
                </div>
                <div class="col-md-4">
                    <label class="form-label"><i class="bi bi-capsule"></i> الأدوية</label>
                    <input asp-for="Medicine" class="form-control" type="number" step="0.01" />
                </div>
                <div class="col-md-4">
                    <label class="form-label"><i class="bi bi-box"></i> الكرتون والأطباق</label>
                    <input asp-for="Cartoon_Plates" class="form-control" type="number" step="0.01" />
                </div>
                <div class="col-md-4">
                    <label class="form-label"><i class="bi bi-fuel-pump"></i> السولار</label>
                    <input asp-for="Solar" class="form-control" type="number" step="0.01" />
                </div>
                <div class="col-md-4">
                    <label class="form-label"><i class="bi bi-award"></i> الرخص</label>
                    <input asp-for="Licence" class="form-control" type="number" step="0.01" />
                </div>
                <div class="col-md-4">
                    <label class="form-label"><i class="bi bi-search-heart"></i> تحاليل العينات</label>
                    <input asp-for="Sample_Analysis" class="form-control" type="number" step="0.01" />
                </div>
                <div class="col-md-4">
                    <label class="form-label"><i class="bi bi-printer"></i> الطباعة</label>
                    <input asp-for="Prints" class="form-control" type="number" step="0.01" />
                </div>
                <div class="col-md-4">
                    <label class="form-label"><i class="bi bi-megaphone-fill"></i> مصروفات إعلان</label>
                    <input asp-for="Adv" class="form-control" type="number" step="0.01" />
                </div>
                <div class="col-md-4">
                    <label class="form-label"><i class="bi bi-tools"></i> الصيانة</label>
                    <input asp-for="Maintainance" class="form-control" type="number" step="0.01" />
                </div>
                <div class="col-md-4">
                    <label class="form-label"><i class="bi bi-lightbulb"></i> الكهرباء</label>
                    <input asp-for="Electricity" class="form-control" type="number" step="0.01" />
                </div>
            </div>
        </div>

        <!-- 🧮 زر الحفظ -->
        <button type="submit" class="btn btn-export">
            <i class="bi bi-save-fill"></i>
            <span>حفظ المصروفات</span>
        </button>
    </form>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
